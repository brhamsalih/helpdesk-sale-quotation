<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="helpdesk_ticket_form_sale_quotation"
            model="ir.ui.view">
        <field name="name"> helpdesk.ticket.form.sale.quotation</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.ticket_view_form"/>
        <field name="arch" type="xml">
            <!-- الحقول -->
            <xpath expr="//field[@name='sequence']" position="after">
                <separator string="Quotation Details"/>
                <field name="customer_reference"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="uom_id"/>
                <field name="unit_price"/>
                <field name="sale_order_id" readonly="1"/>
            </xpath>

            <!-- الزر -->
            <xpath expr="//header" position="inside">
                <button name="action_create_quotation" string="Create Quotation" type="object" class="btn-primary" invisible="sale_order_id"/>
            </xpath>
        </field>
    </record>
</odoo>